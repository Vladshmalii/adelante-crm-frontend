# Origin бекенда (без /api/...). Пути берутся из OpenAPI-схемы целиком.
# Локально удобнее через прокси dev-сервера (бекенд пускает CORS только с прод-доменов):
#   VITE_API_URL=http://localhost:5173
#   API_PROXY_TARGET=http://localhost:8000
VITE_API_URL=http://localhost:8000
# WebSocket уведомлений (сервис ws/). Локально через прокси: ws://localhost:5173/ws + WS_PROXY_TARGET
VITE_WS_URL=ws://localhost:8001/ws
# Telegram-бот (кнопки «Відкрити бот» / «Нагадування в Telegram»)
VITE_TELEGRAM_BOT_URL=https://t.me/AdelanteCrmBot
# WS_PROXY_TARGET=http://localhost:8001

# Откуда `npm run api:generate` берёт схему (URL или путь к файлу).
OPENAPI_URL=http://localhost:8000/openapi.json
