# Origin бекенда (без /api/...). Пути берутся из OpenAPI-схемы целиком.
# Локально удобнее через прокси dev-сервера (бекенд пускает CORS только с прод-доменов):
#   VITE_API_URL=http://localhost:5173
#   API_PROXY_TARGET=http://localhost:8000
VITE_API_URL=http://localhost:8000

# Откуда `npm run api:generate` берёт схему (URL или путь к файлу).
OPENAPI_URL=http://localhost:8000/openapi.json
