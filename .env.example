# Скопируйте в .env и заполните. Файл .env в git не попадает.

# --- Инфраструктура (docker-compose) ---
MASTER_DB_PASSWORD=adelante
SHARD_ADMIN_PASSWORD=postgres

# --- Backend (префикс ADELANTE_) ---
ADELANTE_ENV=dev
ADELANTE_MASTER_DB_DSN=postgresql+asyncpg://adelante:adelante@postgres-master:5432/adelante_master
ADELANTE_MASTER_DB_DSN_SYNC=postgresql+psycopg://adelante:adelante@postgres-master:5432/adelante_master
ADELANTE_SHARD_ADMIN_DSN=postgresql+psycopg://postgres:postgres@postgres-shards:5432/postgres
ADELANTE_REDIS_URL=redis://redis:6379/0
ADELANTE_CELERY_BROKER_URL=redis://redis:6379/1

ADELANTE_JWT_SECRET=change-me-to-long-random-string
# JSON-список: два ключа валидны одновременно — для ротации
ADELANTE_BOT_API_KEYS=["dev-bot-key"]
ADELANTE_TELEGRAM_BOT_TOKEN=123456:replace-me

# Origin'ы фронтенда для CORS (JSON-список). Не задано — localhost + прод-домены
# ADELANTE_CORS_ORIGINS=["https://adelante.dvms.tech","http://localhost:5173"]
# Адрес админки: ссылка в письме сброса пароля — {адрес}/reset-password?token=...
ADELANTE_FRONTEND_URL=http://localhost:5173
# Сайт записи: бот и напоминания ведут на {адрес}/{slug салона}
ADELANTE_BOOKING_BASE_URL=https://adelante.dvms.tech/booking

# Почта (сброс пароля). Без SMTP_HOST письмо не отправляется — ссылка в логе воркера
ADELANTE_SMTP_HOST=
ADELANTE_SMTP_PORT=587
ADELANTE_SMTP_USER=
ADELANTE_SMTP_PASSWORD=
ADELANTE_SMTP_FROM=Adelante CRM <no-reply@adelante.dvms.tech>
# starttls (587) | ssl (465) | none
ADELANTE_SMTP_SECURITY=starttls

# --- Бот ---
ADELANTE_API_BASE_URL=http://api:8000
ADELANTE_BOT_API_KEY=dev-bot-key

# --- Первый деплой на прод (deploy/bootstrap.sh) ---
# Нужны, пока на сервере нет ни одного салона / администратора; потом их можно удалить.
BOOTSTRAP_SALON_NAME=Adelante
BOOTSTRAP_SALON_SLUG=demo
# Имя переменной с паролем роли шарда этого салона (сама переменная — ниже)
BOOTSTRAP_SALON_SECRET_ENV=SALON_DEMO_DB_PASSWORD
BOOTSTRAP_ADMIN_EMAIL=owner@example.com
# Мин. 8 символов
BOOTSTRAP_ADMIN_PASSWORD=change-me-please
BOOTSTRAP_ADMIN_FIRST_NAME=Власник

# --- Пароли ролей шард-БД ---
# На каждый салон — своя переменная; её имя передаётся в
# salonctl salon create --secret-env ... и хранится в реестре
SALON_DEMO_DB_PASSWORD=demo-password
